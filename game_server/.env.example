NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST/zamin_game?sslmode=require
EXPECTED_DATABASE_NAME=zamin_game
GAME_DOMAIN=your-game-domain.example
WEB_ORIGIN=https://your-game-domain.example
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ID of the sole owner; admin API fails closed if unset.
SUPER_ADMIN_TELEGRAM_ID=
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_MAX_AGE_SECONDS=86400
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
ALLOW_DEV_AUTH=false
# Set to false in public deployments until real-player rights are confirmed in writing.
REAL_PLAYERS_ENABLED=true
# Economy and match values (20,000,000 UZS budget, 18-player squad, S=40 with +2 home advantage) are fixed in
# src/economy.js and src/simulation.js and are no longer read from the environment.
